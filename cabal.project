packages: *.cabal
tests: True
benchmarks: True
write-ghc-environment-files: always
optimization: 2
multi-repl: True

source-repository-package
  type: git
  location: https://github.com/konn/linear-extra.git
  tag: 032fd21d2fb0a13fa27b298293640784b79c52c5
  subdir:
    linear-array-extra
    linear-witness

-- Keep this stanza HERE, not in cabal.project.freeze. CI builds with
-- `--project-file=ci/configs/ghc-X.project`, which imports this file but does
-- NOT read cabal.project.freeze (cabal looks for <project-file>.freeze, which
-- does not exist). A pin that lives only in the freeze is therefore invisible
-- to CI, which then resolves a stale pure-borrow and fails on whatever the API
-- rename touched.
--
-- NOTE: this tag is the head of pure-borrow's `feat/robin-hood-hashmap` branch
-- (PR #37), not a commit on its `main`. It is what brings in
-- `Data.HashMap.RobinHood.Mutable.Linear{,.Borrow}`, which this package's hash
-- map now wraps instead of defining itself. Re-pin to the merge commit once
-- that PR lands.
source-repository-package
  type: git
  location: https://github.com/SoftwareFoundationGroupAtKyotoU/pure-borrow.git
  tag: 4e454db5819dba0ae97f256223c0bf4017bc9015

-- The CodSpeed harness. Not on Hackage, and the same reasoning as the stanza
-- above applies: it must live here rather than in the freeze, so CI's
-- `--project-file=ci/configs/ghc-X.project` sees it.
source-repository-package
  type: git
  location: https://github.com/konn/haskell-codspeed.git
  tag: 2f04e8cce92932215c1c6b80f4737328ac2f2d3b

allow-newer:
  falsify:*,
  optparse-applicative,
  text,

-- falsify >=0.4 moved Test.Tasty.Falsify into the separate tasty-falsify
-- package; the test suite imports it from falsify.
constraints: falsify <0.4

package hashable
  flags: +arch-native
